# Project Metadata
PROJECT_NAME=FastAPI Taskflow API
VERSION=0.1.0

# API Configuration
API_V1_PREFIX=/api/v1

# Database
# Local (no Docker): point at your local postgres instance
# APPLICATION_DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow
# Docker Compose: host must match the service name in docker-compose.yml
APPLICATION_DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@db:5432/taskflow

# Postgres service credentials (consumed by docker-compose.yml)
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
